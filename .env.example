# ============================================================
# KAME WEBSITE — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In Netlify: Site Settings → Environment Variables → add each one.
# Never commit a real .env file — it is already in .gitignore.
# ============================================================

# --- Google PageSpeed Insights API (free tier available) ---
# Get a key: https://developers.google.com/speed/docs/insights/v5/get-started
# Used by: netlify/functions/pagespeed-audit.js
VITE_PAGESPEED_API_KEY=

# --- Google Business Profile API (requires Google Cloud OAuth setup) ---
# Docs: https://developers.google.com/my-business
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=

# --- Google Search Console API ---
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=

# --- Google Analytics (GA4) ---
VITE_GA_MEASUREMENT_ID=

# --- Semrush (Phase 2 — connect once KAME is generating revenue) ---
SEMRUSH_API_KEY=

# --- Ahrefs (Phase 2 — connect once KAME is generating revenue) ---
AHREFS_API_TOKEN=

# --- Contact form (if replacing Netlify Forms with a custom handler) ---
CONTACT_FORM_RECIPIENT_EMAIL=hello@kamedigital.co.zm

# --- Authentication provider (Client Portal) ---
# This project ships with a pluggable auth interface (src/auth/authService.js).
# Set AUTH_PROVIDER to "firebase" | "supabase" | "auth0" once you've chosen one,
# then fill in the matching keys below.
AUTH_PROVIDER=none

# Firebase (if AUTH_PROVIDER=firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Supabase (if AUTH_PROVIDER=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
